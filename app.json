{
  "expo": {
    "name": "HydroFindApp",
    "slug": "HydroFindApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/hydrofind-icon.svg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.JMSoftware.HydroFind",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.JMSoftware.HydroFind",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/hydrofind-foreground.svg",
        "backgroundImage": "./assets/hydrofind-background.svg",
        "monochromeImage": "./assets/hydrofind-monochrome.svg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HydroFind uses your location to set your delivery address and show your rider's progress."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "065a18c6-88db-48d2-bb87-ebd9c712232b"
      }
    },
    "owner": "geromarfe123"
  }
}
